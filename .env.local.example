# Supabase — client browser + sesiune (public, sigur de expus).
# Necesare pentru autentificare (/admin, /cont), prețuri publice și citiri cu RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — folosite doar server-side (API routes), NU trebuie prefixate cu NEXT_PUBLIC_.
# SUPABASE_URL este de regulă identic cu NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — trimitere email tranzacțional
RESEND_API_KEY=
EMAIL_FROM="Dezgandacitorul.ro <notificari@dezgandacitorul.ro>"

# Analytics (Faza 1)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
